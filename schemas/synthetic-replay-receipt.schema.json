{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofgate:synthetic-replay-receipt:v1",
  "title": "ProofGate synthetic replay receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "receipt_id",
    "issued_at",
    "evidence_mode",
    "operator",
    "claim",
    "targets",
    "limitations"
  ],
  "properties": {
    "profile": {
      "const": "proofgate-synthetic-replay/v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_mode": {
      "const": "same-operator-local"
    },
    "operator": {
      "const": "local-demo-operator"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ids",
        "passed_target_ids",
        "passed_count"
      ],
      "properties": {
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "passed_target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "limitations": {
      "const": [
        "synthetic-demo-only",
        "same-operator-local-evidence",
        "not-third-party-verification",
        "not-certification",
        "not-production-assurance"
      ]
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "report",
        "planned_changes",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/fileReference"
        },
        "report": {
          "$ref": "#/$defs/fileReference"
        },
        "planned_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "const": "pass"
        }
      }
    }
  }
}
